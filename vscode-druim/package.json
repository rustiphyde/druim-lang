{
  "name": "druim-language-support",
  "displayName": "Official Druim Language Extension",
  "description": "Language support for the Druim programming language.",
  "icon": "icons/druim.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rustiphyde/druim-lang.git"
  },
  "version": "0.1.2",
  "publisher": "druimlang",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:druim"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "druim",
    "drm",
    "programming language",
    "syntax highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "druim",
        "aliases": [
          "Druim",
          "druim"
        ],
        "extensions": [
          ".drm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/druim.svg",
          "dark": "./icons/druim.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "druim",
        "scopeName": "source.druim",
        "path": "./syntaxes/druim.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Druim",
        "uiTheme": "vs-dark",
        "path": "./themes/druim-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "druim.toggleLineComment",
        "title": "Druim: Toggle Line Comment"
      }
    ],
    "keybindings": [
      {
        "command": "druim.toggleLineComment",
        "key": "ctrl+/",
        "when": "editorTextFocus && editorLangId == druim"
      }
    ],
    "snippets": [
      {
        "language": "druim",
        "path": "./snippets/druim.json"
      }
    ]
  }
}